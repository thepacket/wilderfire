"struct jxyz_ { float x; float y; float z; float color; };
__device__ jxyz_ jxyz__zero() { jxyz_ r_; return r_; }
__device__ void jxyz_assign(jxyz_ *a, jxyz_ b) { a->x = b.x; a->y = b.y; a->z = b.z; a->color = b.color; }
float reg_pod_OFFSETS[4] = {0.0, 0.25, 0.5, 0.75};
struct reg_pod_Pt { float x; float y; };
__device__ reg_pod_Pt reg_pod_Pt_zero() { reg_pod_Pt r_; return r_; }
__device__ reg_pod_Pt reg_pod_Pt_make(float x, float y) { reg_pod_Pt r_; r_.x = x; r_.y = y; return r_; }
__device__ void reg_pod_rotate(reg_pod_Pt *p, float a) {
    float c = cosf(a), s = sinf(a);
    float x = p->x * c - p->y * s;
    p->y = p->x * s + p->y * c;
    p->x = x;
  }
"
`;

